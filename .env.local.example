# --- Model / retrieval providers -------------------------------------------------------
# Real key turns on live model replies in /api/chat (src/features/chat-api/logic/call-claude.ts).
# Until set, /api/chat returns 503 UPSTREAM_UNAVAILABLE for every request -- see
# EXTERNAL_ACCOUNTS_SETUP.md for what to verify once this is live.
ANTHROPIC_API_KEY=sk-ant-...

# Not wired up yet (Steps 11/12, embeddings + Pinecone). retrieveContext() currently runs a
# TF-IDF stub over the scraped corpus (src/features/retrieval/logic/retrieve-context.ts); these
# two only start mattering once that stub is replaced with real embeddings.
OPENAI_API_KEY=sk-...
PINECONE_API_KEY=...
PINECONE_INDEX_NAME=guidance-corpus

# --- Deployment ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://demo.youraiconsultant.ai

# Comma-separated list of origins allowed to call /api/chat cross-origin (see
# src/core/security/cors.ts). Unset means no cross-origin caller is trusted; same-origin
# requests (the widget served from NEXT_PUBLIC_APP_URL itself) are unaffected either way.
# Example: ALLOWED_ORIGINS=https://guidancehomeservices.com,https://www.guidancehomeservices.com
ALLOWED_ORIGINS=

# Fires a webhook on lead-capture events (Step 34) once set; until then, lead-capture just logs
# to the audit log and in-memory/JSONL stores (src/features/lead-lifecycle). No payload shape is
# implemented yet -- see EXTERNAL_ACCOUNTS_SETUP.md before setting this.
LEAD_WEBHOOK_URL=

# Optional override -- see src/features/rate-limit/logic/limiter.ts. Defaults to 2000/hour if unset.
RATE_LIMIT_GLOBAL_PER_HOUR=

# --- Database (Step 7) ----------------------------------------------------------------------
# Not wired up yet. lead-lifecycle, lead-extraction, agent-records, and audit-log all currently
# use in-memory Maps and/or append-only JSONL files as an explicit stand-in (see the "Step 7
# stand-in" comments in each feature's data/ or logic/ layer) -- same shapes as
# supabase/migrations/0001_initial_schema.sql, so pointing them at a real Postgres/Supabase
# instance is a swap, not a redesign. See EXTERNAL_ACCOUNTS_SETUP.md.
DATABASE_URL=
